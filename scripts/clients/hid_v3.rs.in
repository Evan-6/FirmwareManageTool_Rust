//! @HEADER@
//!
//! A transport implements three calls over the platform HID API:
//!
//! ```ignore
//! fn feature(&mut self) -> Result<Option<[u8; 64]>>;          // id 14 in byte 0
//! fn write(&mut self, report: &[u8; 64]) -> Result<()>;       // id 12
//! fn read(&mut self) -> Result<Option<[u8; 64]>>;             // id 13
//! ```
//!
//! Nothing else is required: no scanning, no UI, no flashing.

use std::io;

pub const REPORT_SIZE: usize = 64;
pub const OUT_ID: u8 = 12;
pub const IN_ID: u8 = 13;
pub const FEATURE_ID: u8 = 14;
pub const VERSION: u8 = 3;
pub const MAX_PAYLOAD: usize = 51;
pub const HEADER: usize = 13;

@OPCODES@

pub type Result<T> = std::result::Result<T, Error>;

#[derive(Debug)]
pub enum Error {
    Io(io::Error),
    Protocol(&'static str),
    Device { code: u8 },
    Timeout,
    Exhausted,
    Invalid(&'static str),
}

impl std::fmt::Display for Error {
    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
        match self {
            Self::Io(error) => write!(f, "{error}"),
            Self::Protocol(text) => write!(f, "{text}"),
            Self::Device { code } => write!(f, "{} (code {code})", fault_text(*code)),
            Self::Timeout => write!(f, "control reply timed out"),
            Self::Exhausted => write!(f, "sequence exhausted; open a new session"),
            Self::Invalid(text) => write!(f, "{text}"),
        }
    }
}

impl std::error::Error for Error {}

impl From<io::Error> for Error {
    fn from(error: io::Error) -> Self {
        Self::Io(error)
    }
}

pub fn fault_text(code: u8) -> &'static str {
    match code {
        1 => "framing",
        2 => "busy (same session id, or eight owners already open)",
        3 => "invalid input",
        5 => "lease expired",
        6 => "HID send failed",
        7 => "USB disconnect",
        8 => "overflow or stale output",
        9 => "duplicate sequence",
        10 => "sequence gap",
        _ => "unknown",
    }
}

/// The caller owns HID transport; this crate only formats protocol 3.
pub trait Transport {
    fn feature(&mut self) -> Result<Option<[u8; REPORT_SIZE]>>;
    fn write(&mut self, report: &[u8; REPORT_SIZE]) -> Result<()>;
    /// `Ok(None)` means the timeout expired with nothing to read.
    fn read(&mut self) -> Result<Option<[u8; REPORT_SIZE]>>;
}

#[derive(Clone, Copy, Debug, Default)]
pub struct Feature {
    pub board: u8,
    pub major: u8,
    pub minor: u8,
    pub patch: u8,
    pub lease_ms: u16,
    pub poll_ms: u8,
    pub capabilities: u32,
}

impl Feature {
    pub fn supports_nkro(&self) -> bool {
        self.capabilities & 1 != 0
    }
    pub fn supports_consumer(&self) -> bool {
        self.capabilities & 2 != 0
    }
    pub fn supports_mouse(&self) -> bool {
        self.capabilities & 4 != 0
    }
    pub fn supports_sessions(&self) -> bool {
        self.capabilities & 8 != 0
    }
}

#[derive(Clone, Copy, Debug, Default)]
pub struct Status {
    pub received: u32,
    pub completed: u32,
    pub pending: u8,
    pub lease_ms: u16,
    pub rx: u16,
    pub tx: u16,
    pub hid: u16,
    pub failsafe: u16,
    pub snapshot: [u8; 31],
}

#[derive(Clone, Copy, Debug, Default)]
pub struct StatusExt {
    pub uptime_ms: u32,
    pub late_max_us: u16,
    pub out_depth: u8,
    pub rx_depth: u8,
    pub tx_depth: u8,
    pub sessions: u8,
    pub last_fault: u8,
    pub last_fault_age_ms: Option<u32>,
    pub reset_reason: u8,
    pub boot_count: u16,
    pub build: u32,
}

#[derive(Clone, Copy, Debug, Default)]
pub struct SessionInfo {
    pub id: u16,
    pub lease_ms: u16,
    pub held: u8,
    pub flags: u8,
}

pub struct Reply {
    pub opcode: u8,
    pub sequence: u32,
    pub payload: Vec<u8>,
}

pub struct Client<T: Transport> {
    transport: T,
    session: u32,
    sequence: u32,
    last_heartbeat_ms: u64,
}

impl<T: Transport> Client<T> {
    pub fn new(transport: T, session: u32) -> Self {
        Self {
            transport,
            session: session.max(1),
            sequence: 0,
            last_heartbeat_ms: 0,
        }
    }

    pub fn session(&self) -> u32 {
        self.session
    }

    pub fn verify(&mut self) -> Result<Feature> {
        let report = self
            .transport
            .feature()?
            .ok_or(Error::Protocol("no Feature 14 reply"))?;
        if report[0] != FEATURE_ID {
            return Err(Error::Protocol("Feature 14 reply has the wrong id"));
        }
        if &report[1..5] != b"FMT3" || report[5] != VERSION {
            return Err(Error::Protocol("Feature 14 is not protocol 3"));
        }
        Ok(Feature {
            board: report[6],
            major: report[7],
            minor: report[8],
            patch: report[9],
            lease_ms: u16::from_le_bytes([report[10], report[11]]),
            poll_ms: report[14],
            capabilities: u32::from_le_bytes([report[15], report[16], report[17], report[18]]),
        })
    }

    pub fn open(&mut self) -> Result<()> {
        self.command(OPEN, &[], true).map(|_| ())
    }

    pub fn close(&mut self) -> Result<()> {
        self.command(CLOSE, &[], true).map(|_| ())
    }

    pub fn heartbeat(&mut self, now_ms: u64) -> Result<()> {
        self.command(HEARTBEAT, &[], false)?;
        self.last_heartbeat_ms = now_ms;
        Ok(())
    }

    pub fn maybe_heartbeat(&mut self, now_ms: u64, interval_ms: u64) -> Result<()> {
        if now_ms.saturating_sub(self.last_heartbeat_ms) >= interval_ms {
            self.heartbeat(now_ms)?;
        }
        Ok(())
    }

    pub fn status(&mut self) -> Result<Status> {
        let reply = self.command(STATUS, &[], true)?;
        let payload = &reply.payload;
        if payload.len() != 51 || payload[0] != 0 {
            return Err(Error::Protocol("bad STATUS payload"));
        }
        let mut snapshot = [0u8; 31];
        snapshot.copy_from_slice(&payload[20..51]);
        Ok(Status {
            received: u32::from_le_bytes(payload[1..5].try_into().unwrap()),
            completed: u32::from_le_bytes(payload[5..9].try_into().unwrap()),
            pending: payload[9],
            lease_ms: u16::from_le_bytes(payload[10..12].try_into().unwrap()),
            rx: u16::from_le_bytes(payload[12..14].try_into().unwrap()),
            tx: u16::from_le_bytes(payload[14..16].try_into().unwrap()),
            hid: u16::from_le_bytes(payload[16..18].try_into().unwrap()),
            failsafe: u16::from_le_bytes(payload[18..20].try_into().unwrap()),
            snapshot,
        })
    }

    pub fn status_ext(&mut self) -> Result<StatusExt> {
        let reply = self.command(STATUS_EXT, &[], true)?;
        let payload = &reply.payload;
        if payload.len() != 23 || payload[0] != 0 {
            return Err(Error::Protocol("bad STATUS_EXT payload"));
        }
        let age = u32::from_le_bytes(payload[12..16].try_into().unwrap());
        Ok(StatusExt {
            uptime_ms: u32::from_le_bytes(payload[1..5].try_into().unwrap()),
            late_max_us: u16::from_le_bytes(payload[5..7].try_into().unwrap()),
            out_depth: payload[7],
            rx_depth: payload[8],
            tx_depth: payload[9],
            sessions: payload[10],
            last_fault: payload[11],
            last_fault_age_ms: (age != u32::MAX).then_some(age),
            reset_reason: payload[16],
            boot_count: u16::from_le_bytes(payload[17..19].try_into().unwrap()),
            build: u32::from_le_bytes(payload[19..23].try_into().unwrap()),
        })
    }

    pub fn sessions(&mut self) -> Result<Vec<SessionInfo>> {
        let reply = self.command(SESSION_LIST, &[], true)?;
        if reply.payload.len() != 48 {
            return Err(Error::Protocol("bad SESSION_LIST payload"));
        }
        let mut out = Vec::new();
        for entry in reply.payload.chunks_exact(6) {
            let id = u16::from_le_bytes([entry[0], entry[1]]);
            if id != 0 {
                out.push(SessionInfo {
                    id,
                    lease_ms: u16::from_le_bytes([entry[2], entry[3]]),
                    held: entry[4],
                    flags: entry[5],
                });
            }
        }
        Ok(out)
    }

    pub fn barrier(&mut self) -> Result<()> {
        self.command(BARRIER, &[], true).map(|_| ())
    }

    pub fn release_all(&mut self) -> Result<()> {
        self.command(RELEASE, &[], true).map(|_| ())
    }

    pub fn bootloader(&mut self) -> Result<()> {
        self.command(BOOTLOADER, &[], true).map(|_| ())
    }

    pub fn key(&mut self, page: u16, usage: u16, down: bool) -> Result<()> {
        let mut payload = [0u8; 5];
        payload[..2].copy_from_slice(&page.to_le_bytes());
        payload[2..4].copy_from_slice(&usage.to_le_bytes());
        payload[4] = u8::from(down);
        self.command(KEY, &payload, false).map(|_| ())
    }

    pub fn snapshot(&mut self, state: &[u8; 31]) -> Result<()> {
        self.command(SNAPSHOT, state, false).map(|_| ())
    }

    pub fn mouse_move(&mut self, dx: i16, dy: i16) -> Result<()> {
        if !(-1024..=1024).contains(&dx) || !(-1024..=1024).contains(&dy) {
            return Err(Error::Invalid("mouse move is limited to +/-1024 per axis"));
        }
        let mut payload = [0u8; 4];
        payload[..2].copy_from_slice(&dx.to_le_bytes());
        payload[2..].copy_from_slice(&dy.to_le_bytes());
        self.command(MOVE, &payload, false).map(|_| ())
    }

    pub fn buttons(&mut self, mask: u8) -> Result<()> {
        if mask & !0x1F != 0 {
            return Err(Error::Invalid("buttons are bits 0-4"));
        }
        self.command(BUTTONS, &[mask], false).map(|_| ())
    }

    pub fn wheel(&mut self, vertical: i16, horizontal: i16) -> Result<()> {
        if !(-1024..=1024).contains(&vertical) || !(-1024..=1024).contains(&horizontal) {
            return Err(Error::Invalid("wheel is limited to +/-1024 per axis"));
        }
        let mut payload = [0u8; 4];
        payload[..2].copy_from_slice(&vertical.to_le_bytes());
        payload[2..].copy_from_slice(&horizontal.to_le_bytes());
        self.command(WHEEL, &payload, false).map(|_| ())
    }

    fn command(&mut self, opcode: u8, payload: &[u8], reply: bool) -> Result<Reply> {
        if payload.len() > MAX_PAYLOAD {
            return Err(Error::Invalid("payload is at most 51 bytes"));
        }
        self.sequence = self
            .sequence
            .checked_add(1)
            .ok_or(Error::Exhausted)?;
        let sequence = self.sequence;
        let mut report = [0u8; REPORT_SIZE];
        report[0] = OUT_ID;
        report[1] = VERSION;
        report[2] = opcode;
        report[3] = payload.len() as u8;
        report[5..9].copy_from_slice(&self.session.to_le_bytes());
        report[9..13].copy_from_slice(&sequence.to_le_bytes());
        report[13..13 + payload.len()].copy_from_slice(payload);
        self.transport.write(&report)?;
        if !reply {
            return Ok(Reply {
                opcode: 0,
                sequence,
                payload: Vec::new(),
            });
        }
        self.await_reply(opcode, sequence)
    }

    fn await_reply(&mut self, opcode: u8, sequence: u32) -> Result<Reply> {
        loop {
            let Some(report) = self.transport.read()? else {
                continue;
            };
            if report[0] != IN_ID || report[1] != VERSION || report[4] != 0 {
                return Err(Error::Protocol("bad input report framing"));
            }
            let length = usize::from(report[3]);
            if length > MAX_PAYLOAD {
                return Err(Error::Protocol("payload longer than 51 bytes"));
            }
            if u32::from_le_bytes(report[5..9].try_into().unwrap()) != self.session {
                continue;
            }
            let got = report[2];
            let got_sequence = u32::from_le_bytes(report[9..13].try_into().unwrap());
            if got == EVENT {
                return Err(Error::Device { code: report[13] });
            }
            if got != opcode | 0x80 || got_sequence != sequence {
                continue;
            }
            let payload = report[13..13 + length].to_vec();
            if payload.is_empty() {
                return Err(Error::Protocol("empty control reply"));
            }
            if opcode == SESSION_LIST {
                return Ok(Reply {
                    opcode: got,
                    sequence: got_sequence,
                    payload,
                });
            }
            if payload[0] != 0 {
                return Err(Error::Device { code: payload[0] });
            }
            return Ok(Reply {
                opcode: got,
                sequence: got_sequence,
                payload,
            });
        }
    }
}
